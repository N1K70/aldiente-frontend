{
  "name": "aldiente-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "qa:gate": "npm run typecheck && npm run build",
    "qa:smoke:routes": "node scripts/qa-smoke-routes.mjs",
    "qa:smoke:roles": "node scripts/qa-smoke-role-redirects.mjs",
    "qa:smoke:all": "npm run qa:smoke:routes && npm run qa:smoke:roles",
    "qa:smoke:local": "powershell -ExecutionPolicy Bypass -File scripts/qa-smoke-local.ps1",
    "qa:release:local": "npm run qa:mock-guard && npm run qa:encoding-guard && npm run qa:gate && npm run qa:smoke:all && npm run qa:navigation && npm run qa:visual:snapshots",
    "qa:env:production": "node scripts/qa-production-env.mjs",
    "qa:mock-guard": "node scripts/qa-production-mock-guard.mjs",
    "qa:encoding-guard": "node scripts/qa-source-encoding-guard.mjs",
    "qa-chat:contract": "npm run qa:chat:attachment-contract",
    "qa:chat:attachment-contract": "node scripts/qa-chat-attachment-contract.mjs",
    "qa:chat:attachment-contract:fixture": "node scripts/qa-chat-attachment-contract.mjs docs/fixtures/chat-attachments.sample.json",
    "qa:chat:attachment-contract:all": "npm run qa:chat:attachment-contract && npm run qa:chat:attachment-contract:fixture",
    "qa:funnel:event-contract": "node scripts/qa-funnel-event-contract.mjs",
    "qa:navigation": "node scripts/qa-navigation-contract.mjs",
    "qa:visual:snapshots": "node scripts/qa-visual-snapshots.mjs"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
